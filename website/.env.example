# Public URL of the site, used for Stripe redirects and email links.
BASE_URL=https://your-domain.com
PORT=3000
NODE_ENV=production

# Where orders.db and uploaded files are stored. Must be on a persistent disk.
DATA_DIR=/data

# Password for https://your-domain.com/admin (any username).
ADMIN_PASSWORD=change-me-to-something-long

# Stripe: https://dashboard.stripe.com/apikeys and /webhooks
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Shown on the site and used as reply-to for client emails.
CONTACT_EMAIL=you@your-domain.com
# Where new-order notifications go (defaults to CONTACT_EMAIL).
ADMIN_EMAIL=you@your-domain.com

# Outgoing email (any SMTP provider: Brevo, Postmark, Mailgun, Gmail app password…).
# Without SMTP_HOST, emails are printed to the server log instead of sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Leandro Brouschert <orders@your-domain.com>"
